  "# Figure 3 – Storage Usage Trend and Capacity Forecast\n",
  "\n",
  "This visualisation analyses storage growth across the MediCore infrastructure to identify long-term capacity trends and support infrastructure planning decisions.\n",
  "\n",
  "Monitoring storage growth is important because healthcare systems retain increasing volumes of patient records, audit logs, backups and application data. Understanding growth rates helps ensure sufficient capacity is available while reducing the risk of service disruption caused by exhausted storage resources."
 ]
},
{
 "cell_type": "code",
 "execution_count": null,
 "metadata": {},
 "outputs": [],
 "source": [
  "storage_df = (\n",
  "    df[df['vm_id'].str.contains('medicore', case=False)]\n",
  "    .groupby('timestamp')['storage_used_gb']\n",
  "    .mean()\n",
  "    .reset_index()\n",
  ")\n",
  "\n",
  "storage_df['hours'] = range(len(storage_df))\n",
  "\n",
  "coef = np.polyfit(\n",
  "    storage_df['hours'],\n",
  "    storage_df['storage_used_gb'],\n",
  "    1\n",
  ")\n",
  "\n",
  "trend = np.poly1d(coef)\n",
  "\n",
  "storage_df['forecast'] = trend(storage_df['hours'])\n",
  "\n",
  "plt.figure(figsize=(12, 6))\n",
  "\n",
  "plt.plot(\n",
  "    storage_df['timestamp'],\n",
  "    storage_df['storage_used_gb'],\n",
  "    label='Actual Storage Usage'\n",
  ")\n",
  "\n",
  "plt.plot(\n",
  "    storage_df['timestamp'],\n",
  "    storage_df['forecast'],\n",
  "    linestyle='--',\n",
  "    label='Trend Line'\n",
  ")\n",
  "\n",
  "plt.title('Figure 3 - Storage Usage Trend and Capacity Forecast')\n",
  "plt.xlabel('Date')\n",
  "plt.ylabel('Storage Used (GB)')\n",
  "plt.legend()\n",
  "\n",
  "plt.tight_layout()\n",
  "plt.savefig('figure3-storage-trend.png')\n",
  "plt.show()"
 ]
